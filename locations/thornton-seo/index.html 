var SERVICES=['SEO / Local SEO','AIO / GEO','Agentic AI Optimization','VIP Marketing Subscription','Website Design','Landing Pages / Funnels',
  'Conversion Optimization','Google Ads / PPC','Remarketing / Display','Social Media',
  'NFC Marketing','TV / Streaming Ads','Email Marketing','Branding / Logo',
  'Video Marketing','E-commerce / Shopify','Full Marketing Strategy','Not Sure Yet'];

var BUDGETS=['Under $1,000/mo','$1,000-$2,000/mo','$2,000-$4,000/mo',
  '$4,000-$7,500/mo','$7,500+/mo','One-time project','Just the $69.99 membership','Not sure yet'];

function init(){
  botmsg('Hey there! I am the Eye To Ad Media assistant.\n\nI can help you with:\n- SEO, AIO, and GEO strategy\n- Agentic AI optimization\n- Local SEO and Google Maps\n- The VIP Marketing Subscription ($69.99/mo)\n- Website design and landing pages\n- Conversion optimization\n- Google Ads, remarketing, display\n- Social, TV, video, branding, NFC\n- Custom audits and strategy quotes\n\nWhat brings you here today?',1000).then(function(){
    chips(['SEO / AIO / GEO','⚡ VIP Membership','Agentic AI','Website / Funnel','Paid Ads','Get a Free Audit','Pricing / Quote']);
  });
}
function startcap(hint){
  S.capture=true;if(hint&&!S.lead.service)S.lead.service=hint;setprog();
  botmsg('Perfect -- let me collect a few details so we can put together a custom quote or strategy call.\n\nThis takes about 60 seconds. What is your name?',900).then(function(){S.field='name';});
}
function asknext(){
  var l=S.lead;setprog();
  if(!l.name){botmsg('What is your name?',900).then(function(){S.field='name';});return;}
  if(!l.company){botmsg('What company or business are you with?',900).then(function(){S.field='company';});return;}
  if(!l.phone){botmsg('Best phone number to reach you?',900).then(function(){S.field='phone';});return;}
  if(!l.email){botmsg('And your email address?',900).then(function(){S.field='email';});return;}
  if(!l.website){botmsg('What is your website URL? (Type none if you do not have one)',900).then(function(){S.field='website';});return;}
  if(!l.industry){botmsg('What industry is your business in?',900).then(function(){S.field='industry';});return;}
  if(!l.service){botmsg('Which service are you most interested in?',900).then(function(){S.field='service';chips(SERVICES);});return;}
  if(!l.budget){botmsg('What monthly budget range are you working with?',900).then(function(){S.field='budget';chips(BUDGETS);});return;}
  if(!l.notes){botmsg('Last one -- anything else we should know about your goals or timeline? (Type skip to skip)',900).then(function(){S.field='notes';});return;}
  S.field=null;submitlead();
}
function capfield(raw){
  var v=raw.trim();
  if(S.field==='phone'&&v.replace(/\D/g,'').length<10){addmsg(v,'usr');botmsg('Please enter a valid phone number with at least 10 digits.',900);return;}
  if(S.field==='email'&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)){addmsg(v,'usr');botmsg('Please enter a valid email address.',900);return;}
  if(S.field==='notes'&&v.toLowerCase()==='skip'){addmsg('(skipped)','usr');S.lead.notes='N/A';asknext();return;}
  addmsg(v,'usr');S.lead[S.field]=v;asknext();
}
function submitlead(){
  S.capture=false;setprog();var l=S.lead;
  fstat.textContent='Sending...';sbtn.disabled=true;
  fetch(FSURL,{method:'POST',
    headers:{'Content-Type':'application/json','Accept':'application/json'},
    body:JSON.stringify({
      _subject:'New Chatbot Lead -- eyetoad.com -- '+l.name,
      _template:'table',_captcha:'false',
      Name:l.name,Company:l.company,Phone:l.phone,Email:l.email,
      Website:l.website,Industry:l.industry,Service:l.service,
      Budget:l.budget,Notes:l.notes,Source:'eyetoad.com chatbot'
    })
  }).then(function(r){return r.json();})
  .then(function(){
    botmsg('Done! You are all set, '+l.name+'.\n\nYour information has been sent to the Eye To Ad Media team. Expect to hear back within 1 business day -- often much sooner.\n\nIn the meantime you can also call:\n1-800-481-8638\n(720) 249-6588\n\nIs there anything else I can help you with?',900).then(function(){
      chips(['Ask Another Question','Our Services','VIP Membership','Call Now']);
    });
  }).catch(function(){
    botmsg('I had a problem sending your request. Please reach out directly:\nPhone: 1-800-481-8638\nEmail: sales@eyetoad.com\n\nYour info: '+l.name+' | '+l.phone+' | '+l.email,900);
  }).finally(function(){
    fstat.textContent='';sbtn.disabled=false;
    S.lead={name:'',company:'',phone:'',email:'',website:'',industry:'',service:'',budget:'',notes:''};
    S.capture=false;S.field=null;
  });
}
function humanroute(){
  botmsg('Happy to connect you with the team!\n\nPhone: 1-800-481-8638\nPhone: (720) 249-6588\nEmail: sales@eyetoad.com\nHours: Monday-Friday, 8AM-6PM MT\n\nOr I can collect your info for a callback right now.',700).then(function(){
    chips(['Yes, collect my info','No thanks, just browsing']);
  });
}
function services(){
  botmsg('Eye To Ad Media offers a comprehensive marketing stack.\n\n- SEO (local, national, technical, content)\n- AIO -- AI Overview Optimization\n- GEO -- Generative Engine Optimization\n- Agentic AI Optimization\n- Local SEO / Google Maps\n- Website design (custom, WordPress, Shopify)\n- Landing pages and funnels\n- Conversion Rate Optimization\n- Google Ads / PPC\n- Remarketing and programmatic display\n- Social media (organic + paid)\n- NFC marketing\n- TV and streaming (OTT/CTV) advertising\n- Email marketing\n- Branding, logo, graphic and print design\n- Video marketing and YouTube ads\n- E-commerce optimization\n\nEverything is custom-scoped -- and every one of these is available at member pricing with the VIP Marketing Subscription.',1000).then(function(){
    chips(['VIP Membership','Get a Free Audit','Pricing / Quote','SEO / AIO / GEO','Talk to a Human']);
  });
}
function route(text){
  var t=norm(text);
  if(has(t,['see membership page','membership page'])){addmsg(text,'usr');window.location.href='/marketing-subscription/';return;}
  if(has(t,['audit','free audit','audit my site'])){addmsg(text,'usr');startcap('SEO / Conversion Audit');return;}
  if(has(t,['quote','i want','i need','help me','help with','interested in','ready to start','get started','hire','work with you','sign up'])){
    addmsg(text,'usr');startcap();return;
  }
  if(has(t,['talk to a human','speak to someone','book a call','callback','request a callback'])){addmsg(text,'usr');humanroute();return;}
  if(has(t,['call now','call us'])){
    addmsg(text,'usr');
    botmsg('Call us anytime:\n\n1-800-481-8638\n(720) 249-6588\n\nMonday-Friday, 8AM-6PM MT.',700).then(function(){chips(['Get a Quote','Our Services']);});
    return;
  }
  if(has(t,['services','what do you do','show services'])){addmsg(text,'usr');services();return;}
  if(has(t,['yes, collect my info','yes collect','yes start','yes, request a callback'])){addmsg(text,'usr');startcap();return;}
  if(has(t,['no thanks','just browsing'])){
    addmsg(text,'usr');
    botmsg('No problem! Feel free to ask anything whenever you are ready.',700).then(function(){
      chips(['SEO / AIO / GEO','VIP Membership','Website / Funnel','Paid Ads','Pricing / Quote']);
    });
    return;
  }
  if(has(t,['ask another','more questions'])){
    addmsg(text,'usr');
    botmsg('Of course! Ask me anything about SEO, AIO, GEO, agentic AI, the VIP membership, web design, ads, social media, TV, branding, or anything marketing-related.',700).then(function(){
      chips(['SEO / AIO / GEO','VIP Membership','Paid Ads','Website / Funnel','Get a Quote']);
    });
    return;
  }
  if(has(t,['seo / aio / geo'])){addmsg(text,'usr');lookupkb('seo');return;}
  if(has(t,['website / funnel'])){addmsg(text,'usr');lookupkb('website');return;}
  if(has(t,['paid ads'])){addmsg(text,'usr');lookupkb('ppc');return;}
  if(has(t,['aio & geo','geo strategy','aio strategy'])){addmsg(text,'usr');lookupkb('geo');return;}
  if(has(t,['local seo / maps'])){addmsg(text,'usr');lookupkb('local seo');return;}
  if(has(t,['conversion optimization'])){addmsg(text,'usr');lookupkb('conversion');return;}
  for(var i=0;i<KB.length;i++){
    if(has(t,KB[i].k)){
      addmsg(text,'usr');
      (function(item){botmsg(item.a,1000).then(function(){if(item.c)chips(item.c);});})(KB[i]);
      return;
    }
  }
  addmsg(text,'usr');
  botmsg('I can help with SEO, AIO, GEO, agentic AI optimization, the VIP Marketing Subscription, web design, ads, social media, TV advertising, branding, NFC, email, and custom audits.\n\nType what you need or choose an option below.',800).then(function(){
    chips(['SEO / AIO / GEO','VIP Membership','Agentic AI','Website / Funnel','Paid Ads','Get a Free Audit','Talk to a Human']);
  });
}
function lookupkb(term){
  for(var i=0;i<KB.length;i++){
    if(has(term,KB[i].k)){
      (function(item){botmsg(item.a,1000).then(function(){if(item.c)chips(item.c);});})(KB[i]);
      return;
    }
  }
}
function handle(raw){
  var v=(raw||'').trim();if(!v)return;
  fstat.textContent='';inp.value='';inp.focus();
  if(S.capture&&S.field){capfield(v);}else{route(v);}
}
fab.addEventListener('click',function(){S.open?closechat():openchat();});
xbtn.addEventListener('click',closechat);
sbtn.addEventListener('click',function(){handle(inp.value);});
inp.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();handle(inp.value);}});
setTimeout(function(){if(!S.ready&&!S.open&&dot)dot.classList.add('on');},14000);
})();
</script>
<!-- End Eye To Ad Media Chatbot Widget -->

